#!/usr/bin/env python3
"""Entrypoint wrapper for cuban."""
import os
import sys

bin_dir = os.path.dirname(os.path.realpath(__file__))
pkg_dir = os.path.join(bin_dir, "cuban_pkg")
if pkg_dir not in sys.path:
    sys.path.insert(0, pkg_dir)

from cuban.cli import main

if __name__ == "__main__":
    main()
