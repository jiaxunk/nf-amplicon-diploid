//
// Notes to End Users.
//
// The workflow should run without editing this configuration file,
// however there may be instances in which you wish to edit this
// file for compute performance or other reasons. Please see:
//
//   https://nextflow.io/docs/latest/config.html#configuration
//
// for further help editing this file.

params {
    // I/O args
    fastq = null
    bam = null
    reference = null
    target = null
    out_dir = "output"
    sample = null
    sample_sheet = null
    analyse_unclassified = false
    analyse_fail = false
    analysis_mode = "reference"
    force_remap = false
    combine_results = false
    igv = false
    store_dir = null

    // filtering, downsampling + trimming args
    min_read_length = 300
    max_read_length = null
    min_read_qual = 10
    drop_frac_longest_reads = 0.05
    take_longest_remaining_reads = true
    reads_downsampling_size = 2000
    trimmer = "porechop"
    trimmer_extra_args = null
    min_n_reads = 40

    // mapping + reference-based variant calling args
    minimap2_extra_args = null
    number_depth_windows = 100
    min_coverage = 20
    snp = true
    sv = true
    phased = true
    override_basecaller_cfg = null
    clair3_model = null
    clair3_model_path = null
    clair3_extra_args = null
    min_sv_support = 5
    min_sv_vaf = 0.1
    sniffles_extra_args = null
    cuban_repeats = null
    cuban_extra_args = null

    // de-novo mode options
    max_de_novo_contigs = 2
    force_spoa_length_threshold = 2000
    spoa_minimum_relative_coverage = 0.15
    spoa_max_allowed_read_length = 5000
    minimum_mean_depth = 30
    primary_alignments_threshold = 0.7
    medaka_target_depth_per_strand = 150
    miniasm_extra_args = null
    racon_extra_args = null
    medaka_extra_args = null

    // misc
    help = false
    version = false
    aws_image_prefix = null
    aws_queue = null
    disable_ping = false
    threads = 4

    // schema etc.
    monochrome_logs = false
    validate_params = true
    show_hidden_params = false
    schema_ignore_params = 'show_hidden_params,validate_params,monochrome_logs,aws_queue,aws_image_prefix,wf,epi2melabs'

    wf {
        fastcat_stats = true
        example_cmd = [
            "--fastq 'nf-amplicon-diploid-demo/diploid_amplicon/fastq'",
            "--reference 'nf-amplicon-diploid-demo/diploid_amplicon/amplicon_reference.fasta'",
            "--target 'nf-amplicon-diploid-demo/diploid_amplicon/target.bed'",
            "--sample_sheet 'nf-amplicon-diploid-demo/diploid_amplicon/sample_sheet.csv'"
        ]
        common_sha = "sha72f3517dd994984e0e2da0b97cb3f23f8540be4b"
        container_sha = "sha0ba67476938520e6f132759780d0a0e902925c59"
        container_sha_medaka = "shacf8338462607b17b1d68dbce212cb93daea50bad"
        e2l_snp_tag = "shabd38f7cf45346fc8601b77ed075e3e1b9f7cd506"
        e2l_sv_tag = "sha8134f9fef5e19605c7fb4c1348961d6771f1af79"
        container_sha_basecalling = "shae423e761540b9d08b526a1eb32faf498f32e8f22"
        agent = null
    }
}

manifest {
    name            = 'jiaxunk/nf-amplicon-diploid'
    author          = 'Jiaxun'
    homePage        = 'https://github.com/jiaxunk/nf-amplicon-diploid'
    description     = 'Diploid amplicon sequencing workflow for reference-based variant calling and de novo haplotype-aware assembly.'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.04.2'
    version         = 'v1.0.0'
}

epi2melabs {
    tags = 'wf-amplicon,diploid,variant calling,structural variants,amplicon,consensus,de novo,alignment'
    icon = 'faDna'
    outdirParam = 'out_dir'
}

process {
    withLabel:wf_common {
        container = "ontresearch/wf-common:${params.wf.common_sha}"
    }
    withLabel:wfamplicon {
        container = "ontresearch/wf-amplicon:${params.wf.container_sha}"
    }
    withLabel:medaka {
        container = "ontresearch/medaka:${params.wf.container_sha_medaka}"
    }
    withLabel:wf_human_snp {
        container = "ontresearch/wf-human-variation-snp:${params.wf.e2l_snp_tag}"
    }
    withLabel:wf_human_sv {
        container = "ontresearch/wf-human-variation-sv:${params.wf.e2l_sv_tag}"
    }
    withLabel:wf_basecalling {
        container = "ontresearch/dorado:${params.wf.container_sha_basecalling}"
    }
    shell = ['/bin/bash', '-euo', 'pipefail']
}

profiles {
    standard {
        docker {
            enabled = true
            runOptions = "--user \$(id -u):\$(id -g) --group-add 100"
        }
    }

    singularity {
        singularity {
            enabled = true
            autoMounts = true
        }
    }

    conda {
        conda.enabled = true
    }

    awsbatch {
        process {
            executor = 'awsbatch'
            queue = "${params.aws_queue}"
            memory = '32G'
            withLabel:wf_common {
                container = "${params.aws_image_prefix}-wf-common:${params.wf.common_sha}"
            }
            withLabel:wfamplicon {
                container = "${params.aws_image_prefix}-wf-amplicon:${params.wf.container_sha}"
            }
            withLabel:medaka {
                container = "${params.aws_image_prefix}-medaka:${params.wf.container_sha_medaka}"
            }
            withLabel:wf_human_snp {
                container = "${params.aws_image_prefix}-wf-human-variation-snp:${params.wf.e2l_snp_tag}"
            }
            withLabel:wf_human_sv {
                container = "${params.aws_image_prefix}-wf-human-variation-sv:${params.wf.e2l_sv_tag}"
            }
            withLabel:wf_basecalling {
                container = "${params.aws_image_prefix}-dorado-cloud:${params.wf.container_sha_basecalling}"
            }
            shell = ['/bin/bash', '-euo', 'pipefail']
        }
    }

    local {
        process.executor = 'local'
    }
}

timeline {
    enabled = true
    overwrite = true
    file = "${params.out_dir}/execution/timeline.html"
}
report {
    enabled = true
    overwrite = true
    file = "${params.out_dir}/execution/report.html"
}
trace {
    enabled = true
    overwrite = true
    file = "${params.out_dir}/execution/trace.txt"
}

env {
    PYTHONNOUSERSITE = 1
    JAVA_TOOL_OPTIONS = "-Xlog:disable -Xlog:all=warning:stderr"
}
